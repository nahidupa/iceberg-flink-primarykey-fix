  "cards": [
    {
      "dot": "cyan",
      "title": "A snapshot is a complete file list",
      "items": [
        "Each commit adds a snapshot with an id, parent and sequence number",
        "Data files are immutable, a commit never edits an existing file",
        "Old snapshots stay readable until expiration removes them"
      ]
    },
    {
      "dot": "violet",
      "title": "The catalog only guarantees the swap",
      "items": [
        "Manifests, manifest list and metadata.json are written first",
        "The catalog compare-and-swaps the current metadata location",
        "A failed swap raises CommitFailedException and is retried"
      ]
    },
    {
      "dot": "rose",
      "title": "Why a duplicate is still valid metadata",
      "items": [
        "A manifest list carries inherited manifests plus the new ones",
        "No rule requires a data file location to appear only once",
        "A scan reads every entry, so those rows are returned twice"
      ]
    }
  ]
