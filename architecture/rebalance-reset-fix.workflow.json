  "cards": [
    {
      "dot": "emerald",
      "title": "What reset() actually clears",
      "items": [
        "commitBuffer, readyBuffer, receivedPartitionCount, currentCommitId",
        "startTime is kept, so the interrupted commit re-drives immediately",
        "onPartitionsLost delegates here too, so a lost assignment resets"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why the replay is now harmless",
      "items": [
        "With no commit id, addReady takes the no-commit branch and counts nothing",
        "isCommitReady returns false while no commit is in flight",
        "The buffer is empty, so no stale envelope can reach AppendFiles"
      ]
    },
    {
      "dot": "amber",
      "title": "The invariant it restores",
      "items": [
        "The offsets map must stay ahead of every buffered envelope",
        "The rewind broke that by lowering the map while the buffer kept higher offsets",
        "Reset empties both, so the replay refills them in lockstep"
      ]
    }
  ]
