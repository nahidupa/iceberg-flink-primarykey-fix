  "cards": [
    {
      "dot": "rose",
      "title": "What this version lacks",
      "items": [
        "CommitState has no reset() method at all",
        "Channel.start() subscribes with no rebalance listener",
        "Nothing tells the coordinator its assignment changed"
      ]
    },
    {
      "dot": "amber",
      "title": "What survives a rebalance",
      "items": [
        "currentCommitId, both buffers and the counter all stay",
        "The consumer rewinds to its last committed offset",
        "The buffer keeps offsets the map no longer records"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why the replay still lands",
      "items": [
        "addResponse re-buffers the same envelopes",
        "addReady still matches the id, so it counts again",
        "isCommitReady fires early on an inflated quorum"
      ]
    }
  ]
}
