    "views": [
      {
        "id": "happy-cycle",
        "label": "One healthy commit cycle",
        "focus": [
          "idle",
          "started",
          "collecting",
          "ready",
          "committed"
        ],
        "note": "The rail itself is unchanged: the branch touched none of the five phases."
      },
      {
        "id": "unseen-rebalance",
        "label": "Nothing observes the rebalance",
        "focus": [
          "rebalance",
          "collecting",
          "ready"
        ],
        "note": "No listener is registered, so the replay re-enters a commit that is still in flight."
      },
      {
        "id": "two-ways-out",
        "label": "Only two ways out",
        "focus": [
          "timeout",
          "failure",
          "idle"
        ],
        "note": "A timeout or a failed commit end the cycle; a rebalance ends nothing."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Commit cycle"
    },
    {
      "id": "exits",
      "label": "Interruptions and recovery"
    }
  ],
  "states": [
    {
      "id": "idle",
      "type": "start",
      "label": "Idle",
